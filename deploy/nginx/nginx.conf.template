# Veyon Chat — the front door. Written from deploy/nginx/nginx.conf.template
# by scripts/setup-server.ps1 (don't edit the copy in runtime/; edit the
# template and re-run setup).
#
#   Users ──► Nginx ──► API workers (FastAPI + WebSocket) ──► Redis / PostgreSQL
#
# Ports open to the internet (same as before Nginx, so the phone app and
# saved links keep working):
#   {{WEB_HTTPS}} https / {{WEB_HTTP}} http  website + its API (/api, /ws) on one address
#   {{API_HTTPS}} https / {{API_HTTP}} http  API only (the phone app)
# The API workers listen on 127.0.0.1 only; nothing reaches them except
# through here.

# Nginx for Windows: one worker process does all the work, and it can hold
# at most 1024 connections at once (each online user's live socket uses two:
# browser→Nginx and Nginx→worker). See deploy/README.md for when to move on.
worker_processes  1;
error_log  logs/error.log warn;
pid        logs/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile           on;
    keepalive_timeout  65;
    server_tokens      off;

    # Uploads (photos, videos, voice notes) — a little above MAX_UPLOAD_BYTES.
    client_max_body_size  {{MAX_BODY}};

    gzip on;
    gzip_types text/css text/javascript application/javascript application/json image/svg+xml;

    log_format  veyon  '$remote_addr [$time_local] "$request" $status $body_bytes_sent '
                       '$request_time "$upstream_addr"';
    access_log  logs/access.log  veyon;

    # WebSocket: pass "Upgrade" through; plain requests keep the upstream
    # connection open for reuse.
    map $http_upgrade $connection_upgrade {
        default  upgrade;
        ''       '';
    }

    # The API workers. least_conn: a new connection goes to the worker with
    # the fewest open ones, so long-lived sockets spread out evenly.
    upstream veyon_api {
        least_conn;
{{UPSTREAMS}}
        keepalive 32;
    }

    ssl_certificate      "{{CERT}}";
    ssl_certificate_key  "{{KEY}}";
    ssl_protocols        TLSv1.2 TLSv1.3;
    ssl_session_cache    shared:SSL:10m;
    ssl_session_timeout  1h;

    # ── Website (+ its API on the same address) ──────────────────────
    server {
        listen       {{WEB_HTTPS}} ssl;
        listen       {{WEB_HTTP}};
        server_name  _;
        root         "{{PUBLIC}}";

        include veyon-api.conf;
        include veyon-site.conf;
    }

    # ── API only (the phone app, older website copies) ───────────────
    server {
        listen       {{API_HTTPS}} ssl;
        listen       {{API_HTTP}};
        server_name  _;

        location / {
            proxy_pass  http://veyon_api;
            include     veyon-proxy.conf;
        }
    }
}
