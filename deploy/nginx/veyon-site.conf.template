# The website (frontend/public), served straight from disk.
index index.html;

# Generated by setup: config.js says "the API is on this address",
# version.json is the site fingerprint open apps poll to update themselves.
location = /config.js {
    alias  "{{SITE}}/config.js";
    add_header  Cache-Control "no-cache";
}
location = /version.json {
    alias  "{{SITE}}/version.json";
    add_header  Cache-Control "no-cache";
}

# Always revalidate the app shell, scripts and styles, so an update shows
# up on the next load instead of a stale copy.
location ~* ^/(index\.html|sw\.js|manifest\.json)$ {
    add_header  Cache-Control "no-cache";
}
location ~* \.(css|js|mjs)$ {
    add_header  Cache-Control "no-cache";
}

location / {
    try_files $uri $uri/ /index.html;
}
