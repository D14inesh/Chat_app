# Linux production template. Copy to .env (or let deploy/ubuntu/setup.sh generate
# backend/.env and its secrets for you). Never commit the real .env.
# Set CORS_ORIGINS / PUBLIC_API_URL to your domain; fill SMTP_* and VAPID_* before going live.

PORT=4000

# PostgreSQL (local)
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=veyon
PGPASSWORD=change-me            # openssl rand -hex 24
PGDATABASE=vesper_chat

# Redis (live state shared by the API workers)
REDIS_URL=redis://:change-me@127.0.0.1:6379/0

# Session signing key: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL=365d
COOKIE_SAMESITE=lax

# Your public address, exactly as opened in the browser (no trailing slash)
CORS_ORIGINS=https://chat.example.com
PUBLIC_API_URL=https://chat.example.com

# Data locations on the server
STORAGE_DIR=/var/lib/veyon/storage
BACKUP_DIR=/var/lib/veyon/backups
# BACKUP_HOUR=2
# BACKUP_KEEP=7
MAX_UPLOAD_BYTES=26214400

# Sign-up codes by email (Gmail App Password: https://myaccount.google.com/apppasswords)
OTP_DEV_MODE=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Web Push (VAPID) - reuse the existing pair or existing subscriptions break
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional
TENOR_API_KEY=
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.2
WHISPER_URL=http://localhost:8500
