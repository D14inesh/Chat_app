# Chat Report Center settings. Copy to .env.
PORT=4700
# 127.0.0.1 = only this PC. Use 0.0.0.0 to open it from other devices on your network.
HOST=127.0.0.1

# The chat application's database (this app only READS it).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=vesper_chat

# Folders of the chat application, for the disk-usage and backup reports.
#CHAT_STORAGE_DIR=  (default: ../storage)
#CHAT_BACKUP_DIR=  (default: ../database/backups)

# Optional: fixed admin password. If empty, you create one on first visit at http://localhost:4700
# ADMIN_PASSWORD=

# Set to 1 when running behind Nginx (deploy/ubuntu/setup.sh does this).
# BEHIND_PROXY=1
