# Copy this file to .env and fill in real values.

PORT=4000
# LAN/phone access (needs backend/certs — run: python gen_cert.py)
HTTPS_PORT=4443

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=vesper_chat

# Sign session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=replace-me-with-a-long-random-string

# How long a login stays valid without the app being opened (renewed on every app start)
SESSION_TTL=365d

# Max attachment size in bytes (default 100 MB)
MAX_UPLOAD_BYTES=26214400

# Where files are stored. Default: ../storage (chat-application/storage)
# STORAGE_DIR=

# --- Separate frontend ---
# Every origin the frontend is opened from, comma-separated.
CORS_ORIGINS=http://localhost:5173,https://localhost:5443,http://127.0.0.1:5173,http://localhost:8080,https://localhost:8443,http://127.0.0.1:8080
# Optional pattern, e.g. any private LAN IP on the frontend's HTTPS port
CORS_ORIGIN_REGEX=https://(192\.168|10|172\.(1[6-9]|2\d|3[01]))(\.\d{1,3}){2,3}:(5443|8443)
# lax  = frontend and backend on the same host, different ports (default)
# none = frontend and backend on different domains (backend must be HTTPS)
COOKIE_SAMESITE=lax

# AI Chat — needs Ollama running locally (free, no API key): https://ollama.com/download
# Then pull the model once:  ollama pull llama3.2
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.2

# Voice-to-text — needs the local Whisper service running
WHISPER_URL=http://localhost:8500

# Reminders — Web Push (VAPID) key pair. Reuse the pair from the existing
# chatapp .env; changing it invalidates every existing push subscription.
VAPID_PUBLIC_KEY=replace-me
VAPID_PRIVATE_KEY=replace-me
VAPID_SUBJECT=mailto:admin@example.com

# GIF search (optional) — free Tenor key: https://developers.google.com/tenor/guides/quickstart
TENOR_API_KEY=

# Sign-up codes are emailed. For a Gmail sender: turn on 2-Step
# Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it (no spaces) below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Local testing only: show the code on screen instead of emailing it.
# OTP_DEV_MODE=1

# Daily database backups (made by the backend itself, newest 7 kept in
# database/backups). PG_BIN only if pg_dump.exe isn't found automatically,
# e.g. C:\Program Files\PostgreSQL\bin
# BACKUP_HOUR=2
# BACKUP_KEEP=7
# BACKUP_DIR=
# PG_BIN=
